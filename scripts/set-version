#!/usr/bin/env python3
"""Set the application version and refresh the build timestamp.

Usage:
  scripts/set-version          # print current version and build timestamp
  scripts/set-version 1.2.3
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from app.version import load_release_info, write_version


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Update the CursorPace Sync Server version."
    )
    parser.add_argument(
        "version",
        nargs="?",
        help="New semver value, e.g. 1.2.3",
    )
    parser.add_argument(
        "--show",
        action="store_true",
        help="Print the current version and build timestamp (default).",
    )
    args = parser.parse_args()

    if args.show or args.version is None:
        info = load_release_info()
        print(f"{info.version}  {info.build_timestamp}")
        return 0

    info = write_version(args.version)
    print(f"Set version {info.version}  build {info.build_timestamp}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
